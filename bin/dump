#!/usr/bin/env python3

import fnmatch
import os
import subprocess
import sys

MAX_DEPTH = 3
IGNORE_DIRS = {
    "node_modules",
    ".git",
    "dist",
    "build",
    ".next",
    "coverage",
}

EXTENSIONS = {
    ".lua",
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".mjs",
    ".cjs",
    ".json",
    ".md",
    ".nix",
    ".go",
    ".sum",
    ".mod",
}


def dump_file(path, root):
    rel = os.path.relpath(path, root).replace(os.sep, "/")
    print(f"//{rel}")
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            print(f.read())
    except Exception as e:
        print(f"// error reading file: {e}")
    print()


def _match_pattern(rel_posix: str, basename: str, pattern: str) -> bool:
    # Convention: patterns with a slash match the relative path; otherwise match the basename.
    # Normalize pattern to posix separators for portability.
    pat = pattern.replace("\\", "/")
    if "/" in pat:
        return fnmatch.fnmatchcase(rel_posix, pat)
    return fnmatch.fnmatchcase(basename, pat)


def is_excluded(path: str, root: str, patterns: list[str]) -> bool:
    """
    Exclude matcher with optional negation:
      - PATTERN excludes matches
      - !PATTERN re-includes matches
    Last match wins (common gitignore / ripgrep convention).
    """
    if not patterns:
        return False

    rel_posix = os.path.relpath(path, root).replace(os.sep, "/")
    basename = os.path.basename(path)

    excluded = False
    for pat in patterns:
        if not pat:
            continue
        neg = pat.startswith("!")
        raw = pat[1:] if neg else pat
        if _match_pattern(rel_posix, basename, raw):
            excluded = not neg
    return excluded


def read_patterns_file(path: str) -> list[str]:
    patterns: list[str] = []
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for line in f:
            s = line.strip()
            if not s or s.startswith("#"):
                continue
            patterns.append(s)
    return patterns


def walk(path, root, patterns, depth=0):
    if depth > MAX_DEPTH:
        return

    for entry in sorted(os.listdir(path)):
        full = os.path.join(path, entry)

        if os.path.isdir(full):
            if entry in IGNORE_DIRS or entry.startswith("."):
                continue
            walk(full, root, patterns, depth + 1)

        elif os.path.isfile(full):
            if os.path.splitext(entry)[1] in EXTENSIONS:
                if is_excluded(full, root, patterns):
                    continue
                dump_file(full, root)


def usage(exit_code=1):
    print(
        "usage: dump [-c] [--exclude PATTERN | -E PATTERN]... [--exclude-from FILE] <file|dir>"
    )
    print("examples:")
    print("  dump --exclude '*.test.*' --exclude '*.spec.*' src")
    print("  dump -E '**/*.test.*' -E '!**/keep-this.test.ts' src")
    print("  dump --exclude-from .dumpignore src")
    sys.exit(exit_code)


def main():
    if len(sys.argv) < 2:
        usage(1)

    copy = False
    patterns: list[str] = []
    args = sys.argv[1:]

    # -c (copy to clipboard) can appear anywhere; handle it first
    if "-c" in args:
        copy = True
        args = [a for a in args if a != "-c"]

    i = 0
    while i < len(args):
        a = args[i]

        # Conventional naming
        if a in ("--exclude", "-E", "--ignore", "-i"):  # keep ignore as an alias
            if i + 1 >= len(args):
                print(f"error: {a} requires a pattern")
                usage(1)
            patterns.append(args[i + 1])
            i += 2
            continue

        if a.startswith("--exclude="):
            patterns.append(a.split("=", 1)[1])
            i += 1
            continue

        if a.startswith("--ignore="):  # alias
            patterns.append(a.split("=", 1)[1])
            i += 1
            continue

        if a == "--exclude-from":
            if i + 1 >= len(args):
                print("error: --exclude-from requires a file path")
                usage(1)
            patterns.extend(read_patterns_file(args[i + 1]))
            i += 2
            continue

        if a in ("-h", "--help"):
            usage(0)

        # First non-flag is the target; stop parsing flags.
        break

    if i >= len(args):
        print("error: missing <file|dir>")
        usage(1)

    target = os.path.abspath(args[i])

    # Capture output if copying
    if copy:
        from io import StringIO

        buf = StringIO()
        sys.stdout = buf

    if os.path.isfile(target):
        root = os.path.dirname(target)
        if not is_excluded(target, root, patterns):
            dump_file(target, root)
    elif os.path.isdir(target):
        walk(target, target, patterns)
    else:
        print("invalid path")
        sys.exit(1)

    if copy:
        subprocess.run(["pbcopy"], input=buf.getvalue(), text=True)
        print(buf.getvalue(), end="")


if __name__ == "__main__":
    main()
