#!/usr/bin/env bash

set -euo pipefail

TMPHOME="${TMPHOME:-}"

if [[ -z "$TMPHOME" ]]; then
  exit 0
fi

if [[ ! -d "$TMPHOME" ]]; then
  exit 0
fi

case "$TMPHOME" in
  /tmp/*|/var/folders/*)
    rm -rf -- "$TMPHOME"
    ;;
  *)
    printf 'Refusing to remove unexpected TMPHOME path: %s\n' "$TMPHOME" >&2
    exit 1
    ;;
esac
